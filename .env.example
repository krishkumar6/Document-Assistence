# Copy to .env and fill in. .env is git-ignored.

# Free: Groq free tier (key from https://console.groq.com/keys)
LLM_PROVIDER=groq
GROQ_API_KEY=

# Free, local, no key: install Ollama, then `ollama pull qwen2.5:3b`
# LLM_PROVIDER=ollama

# Free tier: Google AI Studio key from https://aistudio.google.com/apikey
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=

# Paid: Claude with native citations
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=

# Optional overrides
# LLM_MODEL=
# LLM_BASE_URL=
