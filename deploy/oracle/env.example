# Copy to deploy/oracle/.env and fill in before running upload.ps1 (it is git-ignored).

LLM_PROVIDER=groq
GROQ_API_KEY=
# Everyone who opens the site logs in with any username + this password.
APP_PASSWORD=

# Leave empty to use a free <server-ip>.sslip.io address (HTTPS still works).
# If you own a domain, point an A record at the server IP and put it here.
DOMAIN=
